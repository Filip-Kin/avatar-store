# Copy to .env and fill in. docker-compose refuses to start if a required var is unset.

# Admin portal HTTP Basic fallback password (Authelia SSO is the primary gate).
AVATAR_PORTAL_PASSWORD=

# The Blue Alliance read API key: https://www.thebluealliance.com/account
TBA_API_KEY=

# Discord webhook URL pinged on each public submission.
DISCORD_WEBHOOK_URL=

# Firebase (reuse an existing project). PUBLIC web config; apiKey is a client id, not a secret.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Optional; defaults to <project-id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

# Optional; used in Discord links. Defaults to https://avatars.filipkin.com
PUBLIC_BASE_URL=
